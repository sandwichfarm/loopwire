{
  "name": "loopwire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.3.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:app": "pnpm --filter @loopwire/desktop build",
    "build:docs": "pnpm --filter @loopwire/docs docs:build",
    "check": "pnpm check:verify && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:verify": "pnpm verify:requirements && pnpm verify:scripts && pnpm verify:workflows && pnpm verify:runtime && pnpm verify:tauri",
    "collect:evidence": "node scripts/collect-release-evidence.mjs",
    "collect:support": "node scripts/collect-support-bundle.mjs",
    "release:handoff": "bash scripts/plan-final-release-handoff.sh",
    "release:agent-ready": "bash scripts/verify-agent-release-ready.sh",
    "release:status": "bash scripts/audit-final-release-state.sh",
    "release:select-docs-run": "bash scripts/select-docs-deployment-run.sh",
    "release:fetch-docs-proof": "bash scripts/fetch-docs-deployment-proof.sh",
    "jack:provider": "pnpm --filter @loopwire/audio-host build && node packages/audio-host/dist/jack-ports-cli.js",
    "jack:ports": "pnpm --filter @loopwire/core build && pnpm --filter @loopwire/audio-host build && node scripts/describe-jack-ports.mjs",
    "jack:verify": "pnpm --filter @loopwire/core build && pnpm --filter @loopwire/audio-host build && node scripts/describe-jack-ports.mjs --verify",
    "dsp:provider": "pnpm --filter @loopwire/audio-host build && node packages/audio-host/dist/dsp-provider-cli.js",
    "dsp:plan": "pnpm --filter @loopwire/core build && pnpm --filter @loopwire/audio-host build && node scripts/describe-dsp-provider.mjs",
    "dsp:verify": "pnpm dsp:plan -- --execute",
    "deploy:docs:bunny": "bash scripts/deploy-docs-bunny.sh",
    "e2e:ui": "node scripts/e2e-desktop-ui.mjs",
    "e2e:shell": "node scripts/e2e-desktop-shell.mjs",
    "detect:audio": "pnpm --filter @loopwire/audio-host build && node scripts/detect-audio-backends.mjs --pretty",
    "restore:background": "pnpm --filter @loopwire/core build && pnpm --filter @loopwire/audio-host build && node scripts/restore-background.mjs",
    "lint": "pnpm typecheck",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "autostart:status": "bash scripts/manage-autostart.sh status",
    "autostart:install": "bash scripts/manage-autostart.sh install",
    "verify:autostart": "bash scripts/verify-autostart.sh",
    "verify:install": "bash scripts/verify-install.sh",
    "verify:release": "bash scripts/verify-release-artifacts.sh",
    "verify:release-evidence": "node scripts/verify-release-evidence.mjs",
    "verify:release-readiness": "bash scripts/verify-release-readiness.sh",
    "verify:published-release": "bash scripts/verify-published-release.sh",
    "verify:final-release": "bash scripts/verify-final-release-proof.sh",
    "verify:requirements": "bash scripts/verify-requirements.sh",
    "release:prepare-key": "bash scripts/prepare-release-signing-key.sh",
    "nix:render-release": "bash scripts/render-nix-release-package.sh",
    "verify:nix-release": "bash scripts/verify-nix-release-package.sh",
    "verify:aur": "bash scripts/verify-aur-package.sh",
    "verify:docs": "bash scripts/verify-docs.sh",
    "verify:desktop-binary-launch": "bash scripts/verify-desktop-binary-launch.sh",
    "verify:desktop-preview": "node scripts/verify-desktop-preview.mjs",
    "verify:docs-deployment": "node scripts/verify-docs-deployment-manifest.mjs",
    "verify:docs-live": "bash scripts/verify-docs-live.sh",
    "verify:packaging": "bash scripts/verify-packaging.sh",
    "verify:runtime": "bash scripts/verify-runtime.sh",
    "verify:scripts": "bash scripts/verify-scripts.sh",
    "verify:support-matrix": "node scripts/verify-support-matrix.mjs",
    "verify:tauri": "bash scripts/verify-tauri.sh",
    "verify:workflows": "bash scripts/verify-github-workflows.sh",
    "verify:vm": "bash scripts/vm-matrix.sh validate && bash scripts/vm-matrix.sh verify-cloud-init && bash scripts/vm-matrix.sh verify-handoffs",
    "verify:vm-evidence": "bash scripts/verify-vm-evidence.sh",
    "vm:promote-evidence": "node scripts/promote-vm-evidence.mjs",
    "vm:doctor": "bash scripts/vm-matrix.sh doctor",
    "vm:evidence-status": "bash scripts/vm-matrix.sh evidence-status",
    "vm:host-setup": "bash scripts/vm-matrix.sh host-setup",
    "vm:host-plan": "bash scripts/vm-matrix.sh host-plan",
    "vm:list": "bash scripts/vm-matrix.sh list",
    "vm:plan": "bash scripts/vm-matrix.sh plan",
    "vm:launch": "bash scripts/vm-matrix.sh launch",
    "vm:render-launch-plan": "bash scripts/vm-matrix.sh render-launch-plan",
    "vm:render-runbook": "bash scripts/vm-matrix.sh render-runbook",
    "vm:render-ssh-plan": "bash scripts/vm-matrix.sh render-ssh-plan",
    "vm:render-cloud-init": "bash scripts/vm-matrix.sh render-cloud-init",
    "vm:collect-ssh": "bash scripts/collect-vm-evidence-ssh.sh",
    "vm:collect-matrix": "bash scripts/collect-vm-matrix-evidence.sh",
    "vm:package-evidence": "bash scripts/package-vm-evidence.sh",
    "vm:prepare-release-evidence": "bash scripts/prepare-vm-evidence-release-asset.sh"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
