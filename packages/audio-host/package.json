{
  "name": "@loopwire/audio-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime-browser.d.ts",
      "import": "./dist/runtime-browser.js"
    },
    "./detectors": {
      "types": "./dist/detectors.d.ts",
      "import": "./dist/detectors.js"
    }
  },
  "bin": {
    "loopwire-dsp-provider": "./dist/dsp-provider-cli.js",
    "loopwire-jack-ports": "./dist/jack-ports-cli.js"
  },
  "scripts": {
    "build": "pnpm --filter @loopwire/core build && tsc -p tsconfig.json",
    "test": "pnpm --filter @loopwire/core build && vitest run",
    "typecheck": "pnpm --filter @loopwire/core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loopwire/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
