{
  "name": "@loopwire/audio-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime-browser.d.ts",
      "import": "./dist/runtime-browser.js"
    },
