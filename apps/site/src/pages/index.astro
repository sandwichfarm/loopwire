---
import SiteLayout from "../layouts/SiteLayout.astro";
import screenshot from "../../../../assets/product-screenshot.png";

const title = "Loopwire | Linux virtual audio routing";
const description =
  "A Linux virtual audio router that keeps the graph visible, keeps backend limits honest, and keeps restore paths scriptable.";
const siteUrl = Astro.site ?? new URL("https://loopwire.app");
const canonical = new URL("/", siteUrl).toString();
const ogImage = new URL(screenshot.src, siteUrl).toString();
const sourceInstall = `git clone https://github.com/sandwichfarm/loopwire
cd loopwire
pnpm install
pnpm check`;
const proofItems = [
  ["PipeWire first", "Reference backend with visible graph state and named routes."],
  ["Preview before apply", "Separate saved routing from host mutations so unsupported paths stay explicit."],
  ["Restore that can be audited", "Desktop autostart, background restore, and release evidence stay scriptable."],
  ["Limits shown in plain view", "PulseAudio, JACK, and ALSA gaps stay documented instead of being faked away."]
];
const stats = [
  ["Primary target", "PipeWire desktops"],
  ["Fallback story", "PulseAudio, JACK, ALSA"],
  ["Current install", "Source-first"]
];
const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Loopwire",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Linux",
  description,
  url: canonical,
  image: ogImage,
  screenshot: ogImage,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  }
};
---

<SiteLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(applicationJsonLd)} />
  </Fragment>

  <main class="shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Linux audio routing</p>
        <h1>Loopwire</h1>
        <p class="summary">
          Patch Linux audio like the platform should have shipped: visible routes, named devices, saved mixes,
          startup restore, and backend diagnostics that tell the truth.
        </p>

        <nav class="links" aria-label="Primary links">
          <a class="link primary" href="/docs/guide/install.html">Install</a>
          <a class="link" href="/docs/">Docs</a>
          <a class="link" href="https://github.com/sandwichfarm/loopwire">GitHub</a>
        </nav>

        <div class="command-card" aria-labelledby="source-install-heading">
          <div class="command-copy">
            <div>
              <p id="source-install-heading" class="command-label">Current source install</p>
              <p class="command-note">
                August 30, 2026: public `curl | bash` stays staged behind signed release artifacts. Today’s honest
                path is source install plus docs.
              </p>
            </div>
            <button type="button" class="copy-button" data-copy-install>
              Copy command
            </button>
          </div>
          <pre><code id="source-install-command">{sourceInstall}</code></pre>
          <p id="copy-status" class="sr-only" aria-live="polite"></p>
        </div>

        <ul class="stat-row" aria-label="Current product status">
          {
            stats.map(([label, value]) => (
              <li>
                <span>{label}</span>
                <strong>{value}</strong>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="shot">
        <div class="shot-frame">
          <img
            src={screenshot.src}
            width={screenshot.width}
            height={screenshot.height}
            alt="Loopwire desktop shell showing one saved device, browser and microphone sources, output channels, and monitor destinations connected by visible routes."
          />
        </div>
        <figcaption>One device, visible sources, explicit buses, and monitors you can reason about at a glance.</figcaption>
      </figure>
    </section>

    <section class="proof" aria-labelledby="proof-heading">
      <div class="section-heading">
        <p class="section-kicker">Why it feels different</p>
        <h2 id="proof-heading">The graph stays visible.</h2>
      </div>

      <div class="proof-grid">
        {
          proofItems.map(([title, detail]) => (
            <article class="proof-card">
              <h3>{title}</h3>
              <p>{detail}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <script is:inline>
    const copyButton = document.querySelector("[data-copy-install]");
    const copyStatus = document.querySelector("#copy-status");
    const copyCommand = document.querySelector("#source-install-command");

    if (copyButton instanceof HTMLButtonElement && copyStatus instanceof HTMLElement && copyCommand instanceof HTMLElement) {
      copyButton.addEventListener("click", async () => {
        const text = copyCommand.textContent?.trim() ?? "";

        try {
          await navigator.clipboard.writeText(text);
          copyButton.textContent = "Copied";
          copyStatus.textContent = "Source install command copied to clipboard.";
          window.setTimeout(() => {
            copyButton.textContent = "Copy command";
          }, 1800);
        } catch {
          copyStatus.textContent = "Clipboard copy is unavailable in this browser.";
        }
      });
    }
  </script>
</SiteLayout>

<style>
  .shell {
    width: min(1220px, calc(100vw - 32px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 28px 0 54px;
    display: grid;
    gap: 28px;
  }

  .hero,
  .proof {
    animation: rise 520ms ease both;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(320px, 0.98fr);
    gap: 22px;
    align-items: stretch;
  }

  .hero-copy,
  .shot,
  .proof-card {
    border: 1px solid var(--panel-border);
    border-radius: 30px;
    background:
      linear-gradient(180deg, rgba(18, 27, 24, 0.94), rgba(9, 15, 13, 0.88)),
      radial-gradient(circle at top left, rgba(193, 255, 82, 0.08), transparent 32%);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  .hero-copy {
    padding: clamp(26px, 4vw, 44px);
  }

  .eyebrow,
  .section-kicker,
  .command-label {
    margin: 0;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 14px 0 0;
    font-family: var(--display-font);
    font-size: clamp(4.2rem, 14vw, 9.2rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .summary {
    width: min(33rem, 100%);
    margin: 20px 0 0;
    color: var(--text-soft);
    font-size: clamp(1.06rem, 2vw, 1.22rem);
    line-height: 1.68;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 0;
  }

  .link,
  .copy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    color: var(--text-main);
    font: inherit;
    text-decoration: none;
    border: 1px solid var(--panel-border-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;
  }

  .link:hover,
  .copy-button:hover {
    border-color: rgba(193, 255, 82, 0.6);
    background: rgba(193, 255, 82, 0.08);
    transform: translateY(-1px);
  }

  .link.primary {
    color: #081108;
    font-weight: 700;
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
  }

  .command-card {
    margin: 30px 0 0;
    padding: 18px;
    border: 1px solid rgba(193, 255, 82, 0.16);
    border-radius: 24px;
    background: rgba(8, 13, 11, 0.72);
  }

  .command-copy {
    display: flex;
    gap: 16px;
    align-items: start;
    justify-content: space-between;
  }

  .command-note {
    max-width: 32rem;
    margin: 8px 0 0;
    color: var(--text-faint);
    line-height: 1.52;
  }

  pre {
    overflow-x: auto;
    margin: 18px 0 0;
    padding: 18px;
    font-family: var(--mono-font);
    font-size: 0.95rem;
    line-height: 1.55;
    border: 1px solid rgba(139, 230, 216, 0.14);
    border-radius: 20px;
    background: rgba(3, 6, 5, 0.92);
  }

  code {
    white-space: pre;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 0;
    margin: 24px 0 0;
    list-style: none;
  }

  .stat-row li {
    padding: 16px;
    border: 1px solid rgba(193, 255, 82, 0.12);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
  }

  .stat-row span,
  .shot figcaption {
    display: block;
    color: var(--text-faint);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stat-row strong {
    display: block;
    margin-top: 8px;
    font-size: 1.04rem;
    font-weight: 700;
  }

  .shot {
    margin: 0;
    padding: 18px;
    display: grid;
    gap: 14px;
  }

  .shot-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(193, 255, 82, 0.14);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(9, 13, 12, 0.96), rgba(6, 9, 8, 0.98));
  }

  .shot-frame::before {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, rgba(193, 255, 82, 0.48), transparent);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .proof {
    padding: clamp(22px, 4vw, 34px);
    border: 1px solid var(--panel-border);
    border-radius: 32px;
    background: linear-gradient(180deg, rgba(10, 15, 14, 0.86), rgba(8, 12, 11, 0.92));
  }

  .section-heading {
    display: grid;
    gap: 8px;
    margin-bottom: 18px;
  }

  h2,
  h3 {
    margin: 0;
    font-family: var(--display-font);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .proof-card {
    padding: 18px;
    border-radius: 24px;
  }

  .proof-card h3 {
    font-size: 1.4rem;
  }

  .proof-card p {
    margin: 10px 0 0;
    color: var(--text-soft);
    line-height: 1.58;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .shell {
      width: min(100vw - 20px, 1220px);
      padding-top: 18px;
      gap: 18px;
    }

    .hero-copy,
    .shot,
    .proof {
      border-radius: 24px;
    }

    .command-copy {
      flex-direction: column;
    }

    .stat-row,
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
