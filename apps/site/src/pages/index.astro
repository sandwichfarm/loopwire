---
import SiteLayout from "../layouts/SiteLayout.astro";
import screenshot from "../../../../assets/product-screenshot.png";

const title = "Loopwire | Linux virtual audio routing";
const description =
  "PipeWire-first virtual audio routing for Linux with named devices, honest backend limits, and a desktop UI that keeps the graph visible.";
const siteUrl = Astro.site ?? new URL("https://loopwire.app");
const canonical = new URL("/", siteUrl).toString();
const ogImage = new URL(screenshot.src, siteUrl).toString();
const sourceInstall = `git clone https://github.com/sandwichfarm/loopwire
cd loopwire
pnpm install
pnpm check`;
const releaseBase = "https://github.com/sandwichfarm/loopwire/releases/download/v0.1.0";
const releaseKey =
  "https://raw.githubusercontent.com/sandwichfarm/loopwire/7e0c6b17a5b12efc9f62df9a314781ad9fbb20ec/packaging/release-signing-public.pem";
const installer = "curl -fsSL https://loopwire.app/install.sh | bash";
function nativeInstall(asset: string, command: string) {
  return [
    `curl -fSLO ${releaseBase}/${asset}`,
    `curl -fSLO ${releaseBase}/SHA256SUMS`,
    `curl -fSLO ${releaseBase}/SHA256SUMS.sig`,
    `curl -fsSL ${releaseKey} -o loopwire-release-key.pem`,
    "openssl dgst -sha256 -verify loopwire-release-key.pem -signature SHA256SUMS.sig SHA256SUMS",
    "sha256sum --check --ignore-missing SHA256SUMS",
    command
  ].join(" &&\n");
}
const installOptions = [
  {
    id: "automatic", label: "Automatic", heading: "Install Loopwire", command: installer,
    note: "Recommended. Detects your Linux distribution and architecture, verifies the release, and installs or " +
      "upgrades Loopwire. Shows each step before it runs.",
    detail: "Uses a matching native package, an existing AUR helper, or Nix; otherwise a portable install. Requests " +
      "approval for package-manager changes.",
    href: "/install.sh", link: "Read the installer"
  },
  {
    id: "arch", label: "Arch", heading: "Arch Linux · AUR", command: "yay -S --needed loopwire-bin",
    note: "Prebuilt stable release for x86_64 and ARM64. Requires yay; if you use paru, replace yay with paru. " +
      "Review the package build when prompted.",
    detail: "No AUR helper? Use Automatic for a portable install. The loopwire, loopwire-bin, and loopwire-git packages conflict; choose one.",
    href: "https://aur.archlinux.org/packages/loopwire-bin", link: "View AUR package"
  },
  {
    id: "ubuntu", label: "Ubuntu", heading: "Ubuntu 24.04 · x86_64",
    command: nativeInstall("loopwire_0.1.0-1ubuntu24.04_amd64.deb", "sudo apt install ./loopwire_0.1.0-1ubuntu24.04_amd64.deb"),
    note: "Manual signed v0.1.0 package. Run these steps together in an empty folder; a failed check stops the " +
      "install. Automatic handles these steps for you.",
    detail: "Other Ubuntu versions and ARM64 use the portable path. A native APT repository is planned to shorten this setup.",
    href: "https://github.com/sandwichfarm/loopwire/issues/35", link: "Track simpler APT installs"
  },
  {
    id: "debian", label: "Debian", heading: "Debian 13 · x86_64",
    command: nativeInstall("loopwire_0.1.0-1debian13_amd64.deb", "sudo apt install ./loopwire_0.1.0-1debian13_amd64.deb"),
    note: "Manual signed v0.1.0 package. Run these steps together in an empty folder; a failed check stops the " +
      "install. Automatic handles these steps for you.",
    detail: "Other Debian versions and ARM64 use the portable path. A native APT repository is planned to shorten this setup.",
    href: "https://github.com/sandwichfarm/loopwire/issues/35", link: "Track simpler APT installs"
  },
  {
    id: "fedora", label: "Fedora", heading: "Fedora 44 · x86_64",
    command: nativeInstall("loopwire-0.1.0-1.fc44.x86_64.rpm", "sudo dnf --setopt=localpkg_gpgcheck=0 install ./loopwire-0.1.0-1.fc44.x86_64.rpm"),
    note: "Manual signed v0.1.0 download. Run these steps together in an empty folder. The signed checksum " +
      "authenticates the RPM before DNF installs it.",
    detail: "The RPM has no embedded signature; the signature exception applies only to local packages. Automatic " +
      "handles verification for you. A signed DNF repository is planned.",
    href: "https://github.com/sandwichfarm/loopwire/issues/36", link: "Track simpler Fedora installs"
  },
  {
    id: "opensuse", label: "openSUSE", heading: "openSUSE Tumbleweed · x86_64",
    command: nativeInstall("loopwire-0.1.0-1.x86_64.rpm", "sudo zypper install --allow-unsigned-rpm ./loopwire-0.1.0-1.x86_64.rpm"),
    note: "Manual signed v0.1.0 download. Run these steps together in an empty folder. The signed checksum " +
      "authenticates the RPM before Zypper installs it.",
    detail: "The RPM has no embedded signature; the exception applies to this verified file. Automatic handles " +
      "verification for you. A signed repository is planned.",
    href: "https://github.com/sandwichfarm/loopwire/issues/37", link: "Track simpler openSUSE installs"
  },
  {
    id: "nix", label: "Nix / NixOS", heading: "Nix · user profile",
    command: 'nix --extra-experimental-features "nix-command flakes" profile install github:sandwichfarm/loopwire#loopwire-bin',
    note: "Install the release-bound package into your user profile. Requires Nix; the command enables flakes for this invocation only.",
    detail: "For repeat installs and upgrades, use Automatic. Published hashes cover x86_64 and ARM64; native build proof currently covers x86_64.",
    href: "/docs/guide/install.html#nix-nixos", link: "Nix install details"
  },
  {
    id: "portable", label: "Other Linux", heading: "Portable Linux · user install",
    command: `${installer} -s -- --method portable`,
    note: "Signed x86_64 or ARM64 archive, installed under ~/.local. Run it again to upgrade. Does not need sudo or change your audio configuration.",
    detail: "Requires a compatible glibc desktop with GTK/WebKitGTK libraries. Node.js is needed for background " +
      "restore and provider commands. On NixOS, use the Nix tab.",
    href: "/docs/guide/install.html#portable-linux", link: "Requirements and upgrade details"
  },
  {
    id: "source", label: "Source", heading: "Build from source", command: sourceInstall,
    note: "Contributor checkout. Requires Git, Node.js 22.12+, and pnpm 11.3+. This installs workspace dependencies and runs the project checks.",
    detail: "For a native desktop build, follow the developer guide for Rust and Linux build dependencies.",
    href: "/docs/developer/architecture.html", link: "Developer guide"
  }
];
const capabilities = [
  ["PipeWire", "First-class routing path"],
  ["PulseAudio", "Compatibility adapter"],
  ["JACK", "Existing-port bridge"],
  ["ALSA", "Diagnostics and hardware discovery"]
];
const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Loopwire",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Linux",
  description,
  url: canonical,
  image: ogImage,
  screenshot: ogImage,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  }
};
---

<SiteLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(applicationJsonLd)} />
  </Fragment>

  <main class="shell">
    <section class="hero">
      <p class="eyebrow">Linux virtual audio routing</p>
      <h1>Loopwire</h1>
      <p class="summary">
        PipeWire-first virtual audio routing with named devices, saved mixes, and startup restore for Linux desktops
        that need the routing graph visible instead of hidden in terminal state.
      </p>

      <nav class="links" aria-label="Primary links">
        <a class="link primary" href="/docs/">Docs</a>
        <a class="link" href="https://github.com/sandwichfarm/loopwire">GitHub</a>
        <a class="link" href="https://github.com/sandwichfarm/loopwire/releases">Releases</a>
      </nav>

      <div class="install-card" aria-label="Install Loopwire">
        <div class="install-tabs" role="tablist" aria-label="Installation platform" hidden>
          {installOptions.map((option, index) => (
            <button type="button" role="tab" id={`install-tab-${option.id}`}
              aria-controls={`install-panel-${option.id}`} aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}>{option.label}</button>
          ))}
        </div>
        {installOptions.map((option, index) => (
          <section class="install-panel" id={`install-panel-${option.id}`} role="tabpanel"
            aria-labelledby={`install-tab-${option.id}`} tabindex="0" hidden={index !== 0}>
            <p class="install-label">{option.heading}</p>
            <p class="install-note">{option.note}</p>
            <pre><code>{option.command}</code></pre>
            <p class="install-detail">{option.detail} <a href={option.href}>{option.link}</a></p>
          </section>
        ))}
        <div class="install-copy">
          <button type="button" class="copy-button" data-copy-install hidden>Copy command</button>
          <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
        </div>
        <noscript><p class="install-note">See <a href="/docs/guide/install.html">all platform instructions</a> in the install guide.</p></noscript>
      </div>

      <ul class="capability-row" aria-label="Current capability status">
        {
          capabilities.map(([label, value]) => (
            <li>
              <span>{label}</span>
              <strong>{value}</strong>
            </li>
          ))
        }
      </ul>
    </section>

    <figure class="shot">
      <img
        src={screenshot.src}
        width={screenshot.width}
        height={screenshot.height}
        alt={
          "Loopwire desktop shell showing one saved device, browser and microphone sources, output channels, and " +
          "monitor destinations connected by visible routes."
        }
      />
      <figcaption>Current desktop shell: saved device, visible routes, source cards, outputs, and monitors.</figcaption>
    </figure>
  </main>

  <script is:inline>
    const tablist = document.querySelector('[role="tablist"]');
    const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
    const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));
    const copyButton = document.querySelector("[data-copy-install]");
    const copyStatus = document.querySelector("#copy-status");
    let selected = 0;
    let copyTimer;

    function selectTab(index) {
      selected = index;
      tabs.forEach((tab, tabIndex) => {
        tab.setAttribute("aria-selected", String(tabIndex === index));
        tab.tabIndex = tabIndex === index ? 0 : -1;
        panels[tabIndex].hidden = tabIndex !== index;
      });
      window.clearTimeout(copyTimer);
      copyButton.textContent = "Copy command";
      copyStatus.textContent = "";
    }

    tablist.hidden = false;
    copyButton.hidden = false;
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        const targets = {
          ArrowRight: (index + 1) % tabs.length,
          ArrowLeft: (index + tabs.length - 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1
        };
        if (!(event.key in targets)) return;
        event.preventDefault();
        const target = targets[event.key];
        selectTab(target);
        tabs[target].focus();
      });
    });
    copyButton.addEventListener("click", async () => {
      const copiedIndex = selected;
      const text = panels[copiedIndex].querySelector("code").textContent.trim();
      try {
        await navigator.clipboard.writeText(text);
        if (selected !== copiedIndex) return;
        copyButton.textContent = "Copied";
        copyStatus.textContent = `${tabs[copiedIndex].textContent} install command copied.`;
        copyTimer = window.setTimeout(() => { copyButton.textContent = "Copy command"; }, 1800);
      } catch {
        if (selected === copiedIndex) copyStatus.textContent = "Copy unavailable. Select the command above and copy it manually.";
      }
    });
  </script>
</SiteLayout>

<style>
  .shell {
    width: min(1180px, calc(100vw - 32px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 32px 0 40px;
    display: grid;
    align-content: center;
    gap: 22px;
  }

  .hero,
  .shot {
    animation: rise 520ms ease both;
  }

  .hero {
    display: grid;
    justify-items: center;
    gap: 0;
    padding: clamp(32px, 6vw, 72px) clamp(18px, 4vw, 42px);
    text-align: center;
    border: 1px solid var(--panel-border);
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgba(10, 25, 30, 0.92), rgba(8, 17, 22, 0.86)),
      radial-gradient(circle at top center, rgba(215, 255, 112, 0.08), transparent 36%);
    box-shadow: var(--shadow);
    backdrop-filter: blur(16px);
  }

  .eyebrow {
    margin: 0 0 18px;
    padding: 7px 12px;
    color: var(--accent-warm);
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid rgba(215, 255, 112, 0.24);
    border-radius: 999px;
    background: rgba(215, 255, 112, 0.06);
  }

  h1 {
    margin: 0;
    font-family: var(--display-font);
    font-size: clamp(4.5rem, 17vw, 9.8rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.06em;
  }

  .summary {
    width: min(66ch, 100%);
    margin: 18px 0 0;
    color: var(--text-soft);
    font-size: clamp(1.02rem, 2vw, 1.22rem);
    line-height: 1.65;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 30px 0 0;
  }

  .link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    color: var(--text-main);
    text-decoration: none;
    border: 1px solid var(--panel-border-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }

  .link:hover {
    border-color: rgba(127, 227, 231, 0.58);
    transform: translateY(-1px);
  }

  .link.primary {
    color: #051014;
    font-weight: 700;
    background: var(--accent);
    border-color: transparent;
  }

  .install-card {
    width: min(780px, 100%);
    min-width: 0;
    box-sizing: border-box;
    margin: 28px 0 0;
    padding: 18px;
    text-align: left;
    border: 1px solid var(--panel-border);
    border-radius: 22px;
    background: var(--panel-bg);
  }

  .install-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-bottom: 16px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--panel-border);
  }

  [hidden] { display: none !important; }

  .install-tabs button {
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--text-faint);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .install-tabs button:hover { color: var(--text-main); }
  .install-tabs button[aria-selected="true"] {
    color: var(--accent);
    border-color: var(--panel-border-strong);
    background: rgba(127, 227, 231, 0.08);
  }

  .install-card :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .install-detail, .copy-status {
    color: var(--text-faint);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .install-detail { margin: 14px 0; }
  .install-card a { color: var(--accent); text-underline-offset: 3px; }
  .copy-status { margin: 0; }

  .install-copy {
    display: flex;
    gap: 16px;
    align-items: start;
    justify-content: space-between;
  }

  .install-label {
    margin: 0;
    color: var(--accent-warm);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .install-note {
    margin: 8px 0 0;
    color: var(--text-faint);
    line-height: 1.45;
  }

  .copy-button {
    flex: 0 0 auto;
    min-height: 40px;
    padding: 0 14px;
    color: var(--text-main);
    font: inherit;
    border: 1px solid var(--panel-border-strong);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .copy-button:hover {
    border-color: rgba(127, 227, 231, 0.58);
    background: rgba(127, 227, 231, 0.08);
  }

  pre {
    margin: 18px 0 0;
    padding: 16px 18px;
    overflow-x: auto;
    color: var(--accent);
    font-family: var(--mono-font);
    font-size: 0.95rem;
    line-height: 1.7;
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.28);
  }

  code {
    font-family: inherit;
  }

  .capability-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .capability-row li {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border: 1px solid var(--panel-border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
  }

  .capability-row span {
    color: var(--text-faint);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .capability-row strong {
    font-size: 0.98rem;
    line-height: 1.35;
  }

  .shot {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 18px;
    border: 1px solid var(--panel-border);
    border-radius: 28px;
    background: rgba(6, 12, 16, 0.84);
    box-shadow: var(--shadow);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .shot figcaption {
    color: var(--text-faint);
    font-size: 0.92rem;
    text-align: center;
  }

  @media (max-width: 920px) {
    .shell {
      width: min(100vw - 20px, 1180px);
      padding: 10px 0 20px;
      gap: 14px;
    }

    .hero,
    .shot {
      border-radius: 22px;
    }

    .install-copy {
      flex-direction: column;
      align-items: stretch;
    }

    .copy-button {
      width: 100%;
    }

    .capability-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    h1 {
      letter-spacing: -0.04em;
    }

    .links {
      width: 100%;
    }

    .link {
      flex: 1 1 calc(50% - 6px);
    }

    .capability-row {
      grid-template-columns: 1fr;
    }

    pre {
      padding: 14px;
      font-size: 0.88rem;
    }
  }
</style>
