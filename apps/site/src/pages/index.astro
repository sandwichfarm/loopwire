---
import SiteLayout from "../layouts/SiteLayout.astro";
import screenshot from "../../../../assets/product-screenshot.png";
import aptChannel from "../../../../packaging/repositories/apt-channel.json";
import { aptInstallOption } from "../lib/aptChannel.mjs";

const title = "Loopwire | Linux virtual audio routing";
const description =
  "PipeWire-first virtual audio routing for Linux with named devices, honest backend limits, and a desktop UI that keeps the graph visible.";
const siteUrl = Astro.site ?? new URL("https://loopwire.app");
const canonical = new URL("/", siteUrl).toString();
const ogImage = new URL(screenshot.src, siteUrl).toString();
const sourceInstall = `git clone https://github.com/sandwichfarm/loopwire
cd loopwire
pnpm install
pnpm check`;
const releaseBase = "https://github.com/sandwichfarm/loopwire/releases/download/v0.1.0";
const releaseKey =
  "https://raw.githubusercontent.com/sandwichfarm/loopwire/7e0c6b17a5b12efc9f62df9a314781ad9fbb20ec/packaging/release-signing-public.pem";
const installer = "curl -fsSL https://loopwire.app/install.sh | bash";
function nativeInstall(asset: string, command: string) {
  return [
    `curl -fSLO ${releaseBase}/${asset}`,
    `curl -fSLO ${releaseBase}/SHA256SUMS`,
    `curl -fSLO ${releaseBase}/SHA256SUMS.sig`,
    `curl -fsSL ${releaseKey} -o loopwire-release-key.pem`,
    "openssl dgst -sha256 -verify loopwire-release-key.pem -signature SHA256SUMS.sig SHA256SUMS",
    "sha256sum --check --ignore-missing SHA256SUMS",
    command
  ].join(" &&\n");
}
const installOptions = [
  {
    id: "automatic", label: "Automatic", heading: "Install Loopwire", command: installer,
    note: "Recommended. Detects your Linux distribution and architecture, verifies the release, and installs or " +
      "upgrades Loopwire. Shows each step before it runs.",
    detail: "Uses a matching native package, an existing AUR helper, or Nix; otherwise a portable install. Requests " +
      "approval for package-manager changes.",
    href: "/install.sh", link: "Read the installer"
  },
  {
    id: "arch", label: "Arch", heading: "Arch Linux · AUR", command: "yay -S --needed loopwire-bin",
    note: "Prebuilt stable release for x86_64 and ARM64. Requires yay; if you use paru, replace yay with paru. " +
      "Review the package build when prompted.",
    detail: "No AUR helper? Use Automatic for a portable install. The loopwire, loopwire-bin, and loopwire-git packages conflict; choose one.",
    href: "https://aur.archlinux.org/packages/loopwire-bin", link: "View AUR package"
  },
  aptInstallOption(aptChannel, {
    id: "ubuntu", label: "Ubuntu", heading: "Ubuntu 24.04 · x86_64",
    command: nativeInstall("loopwire_0.1.0-1ubuntu24.04_amd64.deb", "sudo apt install ./loopwire_0.1.0-1ubuntu24.04_amd64.deb"),
    note: "Manual signed v0.1.0 package. Run these steps together in an empty folder; a failed check stops the " +
      "install. Automatic handles these steps for you.",
    detail: "Other Ubuntu versions and ARM64 use the portable path.",
    href: "/docs/guide/apt-repository.html", link: "APT repository setup and availability"
  }),
  aptInstallOption(aptChannel, {
    id: "debian", label: "Debian", heading: "Debian 13 · x86_64",
    command: nativeInstall("loopwire_0.1.0-1debian13_amd64.deb", "sudo apt install ./loopwire_0.1.0-1debian13_amd64.deb"),
    note: "Manual signed v0.1.0 package. Run these steps together in an empty folder; a failed check stops the " +
      "install. Automatic handles these steps for you.",
    detail: "Other Debian versions and ARM64 use the portable path.",
    href: "/docs/guide/apt-repository.html", link: "APT repository setup and availability"
  }),
  {
    id: "fedora", label: "Fedora", heading: "Fedora 44 · x86_64",
    command: nativeInstall("loopwire-0.1.0-1.fc44.x86_64.rpm", "sudo dnf --setopt=localpkg_gpgcheck=0 install ./loopwire-0.1.0-1.fc44.x86_64.rpm"),
    note: "Manual signed v0.1.0 download. Run these steps together in an empty folder. The signed checksum " +
      "authenticates the RPM before DNF installs it.",
    detail: "The RPM has no embedded signature; the signature exception applies only to local packages. Automatic " +
      "handles verification for you. A signed DNF repository is planned.",
    href: "https://github.com/sandwichfarm/loopwire/issues/36", link: "Track simpler Fedora installs"
  },
  {
    id: "opensuse", label: "openSUSE", heading: "openSUSE Tumbleweed · x86_64",
    command: nativeInstall("loopwire-0.1.0-1.x86_64.rpm", "sudo zypper install --allow-unsigned-rpm ./loopwire-0.1.0-1.x86_64.rpm"),
    note: "Manual signed v0.1.0 download. Run these steps together in an empty folder. The signed checksum " +
      "authenticates the RPM before Zypper installs it.",
    detail: "The RPM has no embedded signature; the exception applies to this verified file. Automatic handles " +
      "verification for you. A signed repository is planned.",
    href: "https://github.com/sandwichfarm/loopwire/issues/37", link: "Track simpler openSUSE installs"
  },
  {
    id: "nix", label: "Nix / NixOS", heading: "Nix · user profile",
    command: 'nix --extra-experimental-features "nix-command flakes" profile install github:sandwichfarm/loopwire#loopwire-bin',
    note: "Install the release-bound package into your user profile. Requires Nix; the command enables flakes for this invocation only.",
    detail: "For repeat installs and upgrades, use Automatic. Published hashes cover x86_64 and ARM64; native build proof currently covers x86_64.",
    href: "/docs/guide/install.html#nix-nixos", link: "Nix install details"
  },
  {
    id: "portable", label: "Other Linux", heading: "Portable Linux · user install",
    command: `${installer} -s -- --method portable`,
    note: "Signed x86_64 or ARM64 archive, installed under ~/.local. Run it again to upgrade. Does not need sudo or change your audio configuration.",
    detail: "Requires a compatible glibc desktop with GTK/WebKitGTK libraries. Node.js is needed for background " +
      "restore and provider commands. On NixOS, use the Nix tab.",
    href: "/docs/guide/install.html#portable-linux", link: "Requirements and upgrade details"
  },
  {
    id: "source", label: "Source", heading: "Build from source", command: sourceInstall,
    note: "Contributor checkout. Requires Git, Node.js 22.12+, and pnpm 11.3+. This installs workspace dependencies and runs the project checks.",
    detail: "For a native desktop build, follow the developer guide for Rust and Linux build dependencies.",
    href: "/docs/developer/architecture.html", link: "Developer guide"
  }
];
const applicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Loopwire",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Linux",
  description,
  url: canonical,
  image: ogImage,
  screenshot: ogImage,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  }
};
---

<SiteLayout title={title} description={description} canonical={canonical} ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(applicationJsonLd)} />
  </Fragment>

  <canvas id="signal-field" aria-hidden="true"></canvas>
  <div class="shell">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Loopwire home">
        <svg class="brand-mark" viewBox="0 0 48 40" fill="none" aria-hidden="true">
          <path d="M2 20h10c8 0 8-13 16-13a13 13 0 0 1 0 26c-8 0-8-13-16-13H2" />
          <path d="M46 20H36c-8 0-8 13-16 13a13 13 0 0 1 0-26c8 0 8 13 16 13h10" />
        </svg>
        <span>loopwire</span>
      </a>
      <nav class="links" aria-label="Primary links">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/sandwichfarm/loopwire/releases">Releases</a>
        <a href="https://github.com/sandwichfarm/loopwire">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <h1 id="hero-heading">Sound,<br /><span>connected.</span></h1>
          <p class="summary">Bring apps, mics, and outputs together.<br />A virtual patch bay for Linux.</p>
        </div>
        <a class="product-preview" href={screenshot.src} aria-label="View the full Loopwire application screenshot">
          <img
            src={screenshot.src} width={screenshot.width} height={screenshot.height}
            fetchpriority="high"
            alt="Loopwire desktop shell showing one saved device, app and microphone sources connected to output channels and monitors."
          />
        </a>
      </section>

      <section class="install" aria-labelledby="install-heading">
        <div class="install-intro">
          <h2 id="install-heading">Install Loopwire</h2>
          <a class="text-link" href="/docs/guide/install.html">Installation guide <span aria-hidden="true">↗</span></a>
        </div>
        <div class="install-controls">
          <div class="install-tabs" role="tablist" aria-label="Installation platform" hidden>
            {installOptions.map((option, index) => (
              <button type="button" role="tab" id={`install-tab-${option.id}`}
                aria-controls={`install-panel-${option.id}`} aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}>{option.label}</button>
            ))}
          </div>
          {installOptions.map((option, index) => (
            <section class="install-panel" id={`install-panel-${option.id}`} role="tabpanel"
              aria-labelledby={`install-tab-${option.id}`} tabindex="0" hidden={index !== 0}>
              <p class="install-label">{option.id === "automatic" ? "Detects your platform. Verifies the download." : option.heading}</p>
              <pre><code>{option.command}</code></pre>
              <details class="install-notes">
                <summary>Requirements &amp; options</summary>
                <p>{option.note} {option.detail} <a href={option.href}>{option.link}</a></p>
              </details>
            </section>
          ))}
          <div class="install-copy">
            <button type="button" class="copy-button" data-copy-install hidden>Copy command</button>
            <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
          </div>
          <noscript><p>See <a href="/docs/guide/install.html">all platform instructions</a> in the install guide.</p></noscript>
        </div>
      </section>
    </main>
    <footer><a href="/docs/guide/support-matrix.html">Compatibility &amp; support <span aria-hidden="true">↗</span></a></footer>
  </div>

  <script>
    import { createSignalField } from "../lib/signalField";

    const canvas = document.querySelector<HTMLCanvasElement>("#signal-field");
    const field = canvas ? createSignalField(canvas) : undefined;
    const tablist = document.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-install]")!;
    const copyStatus = document.querySelector<HTMLElement>("#copy-status")!;
    let selected = 0;
    let copyTimer: number | undefined;
    let copyRequest = 0;

    function selectTab(index: number) {
      copyRequest += 1;
      field?.select(tabs[index].id.replace("install-tab-", ""));
      selected = index;
      tabs.forEach((tab, tabIndex) => {
        tab.setAttribute("aria-selected", String(tabIndex === index));
        tab.tabIndex = tabIndex === index ? 0 : -1;
        panels[tabIndex].hidden = tabIndex !== index;
      });
      window.clearTimeout(copyTimer);
      copyButton.textContent = "Copy command";
      copyStatus.textContent = "";
    }

    tablist.hidden = false;
    copyButton.hidden = false;
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        const targets: Record<string, number> = {
          ArrowRight: (index + 1) % tabs.length,
          ArrowLeft: (index + tabs.length - 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1
        };
        if (!(event.key in targets)) return;
        event.preventDefault();
        const target = targets[event.key];
        selectTab(target);
        tabs[target].focus();
      });
    });
    copyButton.addEventListener("click", async () => {
      const copiedIndex = selected;
      const request = ++copyRequest;
      const text = panels[copiedIndex].querySelector("code")!.textContent!.trim();
      try {
        await navigator.clipboard.writeText(text);
        if (selected !== copiedIndex || request !== copyRequest) return;
        field?.copied();
        copyButton.textContent = "Copied";
        copyStatus.textContent = `${tabs[copiedIndex].textContent} install command copied.`;
        copyTimer = window.setTimeout(() => { copyButton.textContent = "Copy command"; }, 1800);
      } catch {
        if (selected === copiedIndex && request === copyRequest) {
          copyStatus.textContent = "Copy unavailable. Select the command above and copy it manually.";
        }
      }
    });
    window.addEventListener("pagehide", (event) => {
      window.clearTimeout(copyTimer);
      copyRequest += 1;
      copyButton.textContent = "Copy command";
      copyStatus.textContent = "";
      if (!event.persisted) field?.destroy();
    });
  </script>
</SiteLayout>

<style>
  .shell { position: relative; z-index: 1; width: min(1360px, 100%); margin: auto; padding: 34px 56px 24px; }
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .wordmark { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; }
  .wordmark span { font-size: 34px; font-weight: 650; letter-spacing: -0.065em; }
  .brand-mark { width: 42px; height: 36px; stroke: currentColor; stroke-width: 2.4; }
  .links { display: flex; gap: 28px; font-size: 13px; font-weight: 500; }
  .links a, footer a { text-decoration: none; }
  .links a:hover, footer a:hover { color: var(--accent); }
  .hero { display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: center; gap: 34px; margin: 66px 0 58px; }
  h1 { margin: 0; font-size: clamp(56px, 6.8vw, 96px); font-weight: 500; line-height: 1.03; letter-spacing: -0.075em; }
  h1 span { color: var(--accent); }
  .summary { margin: 28px 0 0; color: var(--muted); font-size: 15px; line-height: 1.8; letter-spacing: -0.02em; }
  .product-preview { display: block; min-width: 0; cursor: zoom-in; }
  .product-preview img { display: block; width: 100%; height: auto; aspect-ratio: 1.8; object-fit: cover; object-position: top; }
  .install { display: grid; grid-template-columns: 0.34fr 1fr; gap: 46px; align-items: start; }
  h2 { margin: 0 0 14px; font-size: 19px; font-weight: 550; letter-spacing: -0.04em; }
  .text-link { font-size: 12px; color: var(--muted); text-underline-offset: 4px; }
  .install-controls { min-width: 0; }
  .install-tabs { display: flex; flex-wrap: wrap; column-gap: 20px; row-gap: 0; margin: -8px 0 24px; }
  .install-tabs button { position: relative; min-height: 40px; padding: 8px 0; color: var(--muted); font-size: 12px; }
  .install-tabs button:hover { color: var(--ink); }
  .install-tabs button[aria-selected="true"] { color: var(--ink); }
  .install-tabs button[aria-selected="true"]::after { position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
    background: var(--accent); content: ""; }
  .install-label { margin: 0 0 12px; color: var(--muted); font-size: 12px; line-height: 1.6; }
  pre { margin: 0; padding: 0 0 8px; overflow-x: auto; font: 14px/1.9 var(--mono-font); color: var(--ink); }
  code { font: inherit; }
  .install-notes { margin: 14px 0 0; color: var(--muted); font-size: 11px; line-height: 1.8; }
  .install-notes summary { display: inline-list-item; cursor: pointer; }
  .install-notes p { max-width: 70ch; margin: 10px 0 0; }
  .install-notes a { text-underline-offset: 3px; }
  .install-copy { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 20px; min-height: 40px; }
  .copy-button { min-height: 40px; padding: 0; color: var(--accent); font-size: 12px; font-weight: 600;
    text-decoration: underline; text-underline-offset: 5px; }
  .copy-status { margin: 0; color: var(--muted); font-size: 11px; }
  footer { padding-top: 38px; color: var(--muted); font-size: 11px; }
  @media (min-width: 1500px) { .hero { margin-top: 88px; margin-bottom: 72px; } }
  @media (max-width: 1000px) {
    .shell { padding: 28px 32px; }
    .hero { gap: 26px; margin: 54px 0 42px; }
    h1 { font-size: clamp(48px, 6.7vw, 72px); }
    .summary { font-size: 13px; }
    .install { grid-template-columns: 0.25fr 1fr; gap: 30px; }
    .install-tabs { column-gap: 16px; }
  }
  @media (max-width: 720px) {
    .shell { padding: 22px 22px 24px; }
    .site-header { gap: 20px; align-items: start; }
    .wordmark { gap: 8px; }
    .wordmark span { font-size: 28px; }
    .brand-mark { width: 32px; height: 30px; }
    .links { gap: 16px; font-size: 11px; flex-wrap: wrap; justify-content: end; max-width: 160px; padding-top: 8px; }
    .hero { grid-template-columns: 1fr; gap: 32px; margin: 44px 0 38px; }
    h1 { font-size: clamp(56px, 12vw, 78px); }
    .summary { margin-top: 20px; font-size: 13px; }
    .product-preview { width: calc(100% + 22px); }
    .install { grid-template-columns: 1fr; gap: 22px; }
    .install-intro { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; }
    h2 { margin: 0; font-size: 18px; }
    .text-link { font-size: 11px; }
    .install-tabs { margin-bottom: 20px; column-gap: 18px; }
    pre { font-size: 12px; }
    .install-copy { margin-top: 12px; }
    footer { padding-top: 32px; }
  }
  @media (max-width: 360px) {
    .shell { padding-right: 18px; padding-left: 18px; }
    .links { max-width: 100px; column-gap: 13px; row-gap: 10px; }
    .product-preview { width: calc(100% + 18px); }
  }
</style>
